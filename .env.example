# Copy sang .env rồi sửa. .env KHÔNG commit.
# Vite tự đọc file này lúc dev/build. Chỉ biến VITE_* mới lộ ra client.

VITE_API_URL=http://localhost:8080

# Thống kê truy cập. Bỏ trống là không tải gì — đo đạc là tuỳ chọn của môi
# trường, không phải phụ thuộc của ứng dụng.
# Umami: không cookie, không lưu IP, không cần biểu ngữ xin phép.
VITE_UMAMI_SRC=
VITE_UMAMI_ID=
