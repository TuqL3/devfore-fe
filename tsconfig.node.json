{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Bài kiểm `*.check.ts` chạy bằng `node --experimental-strip-types`, không chạy
  // trong trình duyệt: chúng thuộc project này chứ không phải project app. Để ở
  // app thì `import 'node:assert/strict'` không có kiểu, mà thêm `"node"` vào
  // types của app lại cho mọi file trong bundle thấy `process` và `Buffer`.
  "include": ["vite.config.ts", "src/**/*.check.ts"]
}
